# Copy this file to .env.local and fill in the values.
# See references/membership-env-setup.md for step-by-step setup instructions.
#
# EVERYTHING HERE IS OPTIONAL TO GET THE SITE RUNNING. Each feature checks for
# its own variables and falls back to built-in content when they are missing, so
# `npm run dev` works on a fresh clone with this file empty. What you set
# decides which features read live data instead of fallbacks.
#
# Nothing here is a NEXT_PUBLIC_ variable except NEXT_PUBLIC_GA_ID — the sheet
# IDs and credentials are read on the server only and must never be exposed.

# ---------------------------------------------------------------------------
# Google service account — required by EVERY sheet-backed feature below.
# Without these, all of them fall back. (Google Cloud Console → service account
# → JSON key.) Share each sheet with the service account email as Viewer.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The PEM private key. Literal "\n" escapes are handled, so pasting the JSON
# key's private_key value verbatim works.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Member roster — powers the /membership status check and the digital member
# ID at /membership/id, which is gated behind that check.
# The long string in the sheet URL between /d/ and /edit.
# Tab "Members": A: Name  B: Email  C: Category  D: Status  E: PMA Class
#                F: Member Since
# ---------------------------------------------------------------------------
MEMBERS_SHEET_ID=
# Optional — defaults to Members!A2:F
# MEMBERS_SHEET_RANGE=Members!A2:F

# ---------------------------------------------------------------------------
# Donation log — powers the giving lookup at /donate/status.
# Falls back to MEMBERS_SHEET_ID when unset, because the donation log belongs
# in the same PRIVATE spreadsheet as the roster — never in the staff-editable
# content sheet below.
# Tab "Donations": A: Reference  B: Email  C: Donor Name  D: Date  E: Amount
#                  F: Fund  G: Status
# References MUST be random, not sequential — see src/lib/donations.ts.
# ---------------------------------------------------------------------------
DONATIONS_SHEET_ID=
# Optional — defaults to Donations!A2:G
# DONATIONS_SHEET_RANGE=Donations!A2:G

# ---------------------------------------------------------------------------
# Staff-editable content — DELIBERATELY a separate spreadsheet from the roster,
# so staff can edit copy without ever seeing the member list.
# One ID drives three tabs:
#   "Content"      A: Key  B: Value        — chairman's message, contact
#                                            details, socials, bank/GCash
#   "FAQ"          A2:G                    — answers for the site assistant
#   "Fund Updates" A: Fund  B: Title  C: Message  D: Date  E: Image URL
#                  F: Published (Yes/No)   — the /donate/impact feed
# Unset means all three run on built-in fallbacks and staff edits do nothing.
# ---------------------------------------------------------------------------
CONTENT_SHEET_ID=

# ---------------------------------------------------------------------------
# News feed on the home page. Unset renders the three sample items.
# Tab "News": A: Title  B: Excerpt  C: Category  D: Date  E: Link
#             F: Published (Yes/No)  G: Image URL
# ---------------------------------------------------------------------------
NEWS_SHEET_ID=

# ---------------------------------------------------------------------------
# Transactional email (Resend) — sends a donor their giving summary from
# /donate/status. Without a key that form reports a service error rather than
# silently pretending to have sent.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Optional — defaults to "PMAFI <noreply@pmafi.org>". Must be a verified
# sending domain in Resend.
# GIVING_FROM_EMAIL=PMAFI <noreply@pmafi.org>

# ---------------------------------------------------------------------------
# Google Analytics 4. Wired but dormant: the script only loads when this is
# set. Awaiting a Measurement ID from PMAFI.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Image URLs in the News and Fund Updates sheets must be Google Drive share
# links (or already on lh3.googleusercontent.com). Any other host is dropped
# with a server-side warning — see src/lib/sheet-image.ts.
